# Godot 4+ specific ignores
.godot/
/android/
/graphify-out/

.omx/

# OS/archive metadata
.DS_Store
__MACOSX/
._*

# graphify cache under scripts
/scripts/graphify-out/

# Local build and generated UI acceptance images
/builds/
/artifacts/story-framework/

# Local agent configuration, caches and reproducible intermediate exports
/.kimi-code/
__pycache__/
*.pyc
/design/**/Backups/
/design/**/preview-frames/
.env
.env.*
!.env.example

# Retired, unlicensed audio remains local; current music is under assets/music/.
/assets/game_bgm.mp3
/assets/game_bgm.mp3.import
/assets/game_bgm.ogg
/assets/game_bgm.ogg.import
/assets/menu_bgm.mp3
/assets/menu_bgm.mp3.import
/assets/menu_bgm.ogg
/assets/menu_bgm.ogg.import

# Downloaded commercial reference images are local research only.
# Keep source URL manifests and project-generated art in version control.
/design/**/reference/*.png
/design/**/reference/*.jpg
/design/**/reference/*.jpeg
/design/**/reference/*.webp
/design/**/reference/*.gif
/design/**/reference/*.import

# Combat feedback captures are reproducible local evidence. Keep a small
# review set in Git instead of every resolution, baseline and intermediate run.
/design/combat-feedback-20261030/**/*.png
/design/combat-feedback-20261030/**/*.png.import
/design/combat-feedback-20261030/source-candidates/
# Full console transcripts and SHA summaries are retained; individual smoke
# logs duplicate those transcripts and stay local or in the CI job output.
/design/combat-feedback-20261030/runtime-evidence/full-check/*.log
/design/combat-feedback-20261030/latency-readability-fix/full-check/*.log
