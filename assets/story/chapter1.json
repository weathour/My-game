  "dialogues": [
    {
      "id": "dlg.c1.opening",
      "entry": "start",
      "npc_id": "swordsman",
      "kind": "optional",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.outpost",
          "value": "available"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "swordsman",
          "text": "前哨已经两天没有回答了。昨晚我又试了一次，还是只有杂音。",
          "next": "end",
          "narration": "通讯台的指示灯亮着。没人碰它。"
        },
        {
          "id": "end",
          "speaker": "swordsman",
          "text": "枪手在桌边等你。他认得去前哨的路，也知道我们该带什么回来。",
          "end": true,
          "narration": "剑士收好耳机，把空出的椅子推向桌边。"
        }
      ],
      "location": "营地 / 通讯台",
      "scene": "radio"
    },
    {
      "id": "dlg.c1.outpost.accept",
      "entry": "start",
      "npc_id": "gunner",
      "kind": "accept",
      "quest_id": "q.c1.outpost",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.outpost",
          "value": "available"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "gunner",
          "text": "去前哨完成清剿，把值班记录带回来。最后一班的人，总会记下点什么。",
          "choices": [
            {
              "id": "accept",
              "text": "接下任务",
              "next": "accepted",
              "command": {
                "type": "accept_quest",
                "quest_id": "q.c1.outpost"
              }
            },
            {
              "id": "details",
              "text": "为什么要取回记录？",
              "next": "details"
            },
            {
              "id": "later",
              "text": "稍后再来",
              "next": "later"
            }
          ],
          "narration": "枪手把地图压平。纸角已经卷了。"
        },
        {
          "id": "details",
          "speaker": "gunner",
          "text": "以前他们连风向都记。哪天没风，也写一句。把那些方位对上，我们才知道干扰从哪儿来。",
          "next": "start",
          "narration": "他的手停在地图上的一个小点。"
        },
        {
          "id": "accepted",
          "speaker": "gunner",
          "text": "那就拜托了。出发前把三个人的装备看一遍，记录拿到后，带回这里给我。",
          "end": true,
          "narration": "枪手递来一只防水袋，袋口折得很整齐。"
        },
        {
          "id": "later",
          "speaker": "gunner",
          "text": "好，先忙你的。地图就放在这里，我再核对一遍路线，等你准备妥当。",
          "end": true,
          "narration": "他把防水袋留在了桌子另一侧。"
        }
      ],
      "location": "营地 / 旧地图前",
      "scene": "outpost"
    },
    {
      "id": "dlg.c1.outpost.reminder",
      "entry": "start",
      "npc_id": "gunner",
      "kind": "reminder",
      "quest_id": "q.c1.outpost",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.outpost",
          "value": "active"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "gunner",
          "text": "还是去前哨，带回那本值班记录。路上不用抢时间，先把人照顾好。",
          "end": true,
          "narration": "地图上，通往前哨的线被描深了一遍。"
        }
      ],
      "location": "营地 / 旧地图前",
      "scene": "outpost"
    },
    {
      "id": "dlg.c1.outpost.turn_in",
      "entry": "start",
      "npc_id": "gunner",
      "kind": "turn_in",
      "quest_id": "q.c1.outpost",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.outpost",
          "value": "ready_to_turn_in"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "gunner",
          "text": "找到了。把记录交给我吧，我来对照地图。整理完，就能请机械师去查裂隙了。",
          "choices": [
            {
              "id": "confirm",
              "text": "交付前哨记录 ×1",
              "next": "done",
              "command": {
                "type": "turn_in_quest",
                "quest_id": "q.c1.outpost"
              }
            },
            {
              "id": "later",
              "text": "稍后交付",
              "next": "later"
            }
          ],
          "narration": "防水袋打开，几粒细沙落在桌上。"
        },
        {
          "id": "done",
          "speaker": "gunner",
          "text": "最后几页都指向裂隙。字越来越小，风向却一天没漏。去找机械师吧，路线我替你标好了。",
          "end": true,
          "narration": "末页写着：灯还亮着，等回音。"
        },
        {
          "id": "later",
          "speaker": "gunner",
          "text": "也好，先由你保管。别把纸摊在风里，等你回来，我们再慢慢看。",
          "end": true,
          "narration": "枪手把防水袋的封口重新压紧。"
        }
      ],
      "location": "营地 / 值班记录",
      "scene": "outpost"
    },
    {
      "id": "dlg.c1.rift.accept",
      "entry": "start",
      "npc_id": "mechanic",
      "kind": "accept",
      "quest_id": "q.c1.rift",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.rift",
          "value": "available"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "mechanic",
          "text": "路线有了，还差一份裂隙样本。完成推进后带回来，我想知道这阵杂音究竟从哪里来。",
          "choices": [
            {
              "id": "accept",
              "text": "接下任务",
              "next": "accepted",
              "command": {
                "type": "accept_quest",
                "quest_id": "q.c1.rift"
              }
            },
            {
              "id": "later",
              "text": "先整理装备",
              "next": "later"
            }
          ],
          "narration": "接收器旁放着一支空玻璃管。"
        },
        {
          "id": "accepted",
          "speaker": "mechanic",
          "text": "玻璃管拿好。样本收进去就盖紧，回营地以后交给我，我们一起听听看。",
          "end": true,
          "narration": "机械师在管口绕了一圈软布。"
        },
        {
          "id": "later",
          "speaker": "mechanic",
          "text": "先把装备整理好吧。这台机器已经响了两天，不差你准备的这点时间。",
          "end": true,
          "narration": "机械师调低接收器的声音，屋里安静了一些。"
        }
      ],
      "location": "营地 / 样本工作台",
      "scene": "rift"
    },
    {
      "id": "dlg.c1.rift.reminder",
      "entry": "start",
      "npc_id": "mechanic",
      "kind": "reminder",
      "quest_id": "q.c1.rift",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.rift",
          "value": "active"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "mechanic",
          "text": "去裂隙完成推进，取一份样本回来。玻璃管还在吧？回来时把它放到我手里就好。",
          "end": true,
          "narration": "空管的位置留着一小圈没有灰的桌面。"
        }
      ],
      "location": "营地 / 样本工作台",
      "scene": "rift"
    },
    {
      "id": "dlg.c1.rift.turn_in",
      "entry": "start",
      "npc_id": "mechanic",
      "kind": "turn_in",
      "quest_id": "q.c1.rift",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.rift",
          "value": "ready_to_turn_in"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "mechanic",
          "text": "样本还有反应。交给我做定位吧，管里的材料会用完，结果我会写下来。",
          "choices": [
            {
              "id": "confirm",
              "text": "交付裂隙样本 ×1",
              "next": "analysis",
              "command": {
                "type": "turn_in_quest",
                "quest_id": "q.c1.rift"
              }
            },
            {
              "id": "later",
              "text": "稍后交付",
              "next": "later"
            }
          ],
          "narration": "玻璃管靠近接收器，杂音忽然变得清楚。"
        },
        {
          "id": "analysis",
          "speaker": "mechanic",
          "text": "在星核那里。你听，杂音每次都在同一个地方停一下；我把这个位置标出来了。",
          "next": "done",
          "narration": "机械师松开旋钮，笔尖落在地图上。"
        },
        {
          "id": "done",
          "speaker": "mage",
          "text": "我也听到了，像呼叫时留下的间隔。去找铁匠吧，装置还缺能让信号过去的核心。",
          "end": true,
          "narration": "法师俯身听了一会儿，才慢慢直起身。"
        },
        {
          "id": "later",
          "speaker": "mechanic",
          "text": "好，先收起来。别让管口松开；你准备好交给我的时候，我再开始分析。",
          "end": true,
          "narration": "机械师把工作台中间的位置空了出来。"
        }
      ],
      "location": "营地 / 接收器旁",
      "scene": "rift"
    },
    {
      "id": "dlg.c1.rift.explanation",
      "entry": "start",
      "npc_id": "mage",
      "kind": "optional",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.rift",
          "value": "completed"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "mage",
          "text": "从前听见这阵杂音，我只想把它关掉。现在知道里面还有呼叫，就总想多听一会儿。",
          "end": true,
          "narration": "窗外的风停了，接收器仍在轻轻作响。"
        }
      ],
      "location": "营地 / 窗边",
      "scene": "rift"
    },
    {
      "id": "dlg.c1.core.accept",
      "entry": "start",
      "npc_id": "blacksmith",
      "kind": "accept",
      "quest_id": "q.c1.core",
      "conditions": [
        {
          "type": "quest_state",
          "quest_id": "q.c1.core",
          "value": "available"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "speaker": "blacksmith",
          "text": "线都接好了，还缺一个稳定核心。去完成星核讨伐，带回1枚，我来把通讯台修好。",
          "choices": [
            {
              "id": "accept",
              "text": "接下任务",
              "next": "accepted",
              "command": {
                "type": "accept_quest",
                "quest_id": "q.c1.core"
              }
            },
            {
              "id": "later",
              "text": "稍后再来",
              "next": "later"
            }
          ],
          "narration": "铁匠擦净底座，留出安放核心的位置。"
        },
        {
          "id": "accepted",
          "speaker": "blacksmith",
          "text": "去吧，核心带回来再交给我。这里的零件我守着，你们三个平安回来就好。",
          "end": true,
          "narration": "他把几颗小螺丝按顺序排在布上。"
        },
        {
          "id": "later",
          "speaker": "blacksmith",
          "text": "不着急。最后一个接口还得磨一磨，你先准备，等回来时就能装了。",
          "end": true,
          "narration": "锉刀又响起来，声音很轻，也很稳。"
        }
      ],
