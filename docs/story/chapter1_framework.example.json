  "dialogues": [
    {
      "id": "dlg.c1.opening", "entry": "start", "npc_id": "swordsman", "kind": "optional",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.outpost", "value": "available"}],
      "nodes": [
        {"id": "start", "speaker": "swordsman", "text": "前哨的信号断了。先带回记录，弄清路上发生了什么。", "next": "end"},
        {"id": "end", "speaker": "swordsman", "text": "枪手在整理路线。准备好后，去找他确认任务。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.outpost.accept", "entry": "start", "npc_id": "gunner", "kind": "accept", "quest_id": "q.c1.outpost",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.outpost", "value": "available"}],
      "nodes": [
        {"id": "start", "speaker": "gunner", "text": "到前哨完成清剿，带回观测记录。拿到后回来找我，才能确定下一段路线。", "choices": [
          {"id": "accept", "text": "接下任务", "next": "accepted", "command": {"type": "accept_quest", "quest_id": "q.c1.outpost"}},
          {"id": "details", "text": "为什么要取回记录？", "next": "details"},
          {"id": "later", "text": "稍后再来", "next": "later"}
        ]},
        {"id": "details", "speaker": "gunner", "text": "失联前的信号来自不同方位。凭记忆选路容易走错，记录能把它们对上。", "next": "start"},
        {"id": "accepted", "speaker": "gunner", "text": "任务已记下。整备好三人队伍后，从准备页出发。", "end": true},
        {"id": "later", "speaker": "gunner", "text": "路线留在这里。准备好再来。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.outpost.reminder", "entry": "start", "npc_id": "gunner", "kind": "reminder", "quest_id": "q.c1.outpost",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.outpost", "value": "active"}],
      "nodes": [{"id": "start", "speaker": "gunner", "text": "目标是前哨记录。完成前哨清剿后回来交给我；已有战局可以从准备页继续。", "end": true}]
    },
    {
      "id": "dlg.c1.outpost.turn_in", "entry": "start", "npc_id": "gunner", "kind": "turn_in", "quest_id": "q.c1.outpost",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.outpost", "value": "ready_to_turn_in"}],
      "nodes": [
        {"id": "start", "speaker": "gunner", "text": "把前哨记录交给我，我来整理路线。交付会消耗这份记录，并开放裂隙调查任务。", "choices": [
          {"id": "confirm", "text": "交付前哨记录 ×1", "next": "done", "command": {"type": "turn_in_quest", "quest_id": "q.c1.outpost"}},
          {"id": "later", "text": "稍后交付", "next": "later"}
        ]},
        {"id": "done", "speaker": "gunner", "text": "路线指向裂隙。报告已经留在记录页，接下来找机械师确认调查任务。", "end": true},
        {"id": "later", "speaker": "gunner", "text": "记录先由你保管。回来时再交给我。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.rift.accept", "entry": "start", "npc_id": "mechanic", "kind": "accept", "quest_id": "q.c1.rift",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.rift", "value": "available"}],
      "nodes": [
        {"id": "start", "speaker": "mechanic", "text": "枪手确认了路线。进入裂隙，完成推进后带回一份样本，我才能判断干扰源的位置。", "choices": [
          {"id": "accept", "text": "接下任务", "next": "accepted", "command": {"type": "accept_quest", "quest_id": "q.c1.rift"}},
          {"id": "later", "text": "先整理装备", "next": "later"}
        ]},
        {"id": "accepted", "speaker": "mechanic", "text": "目标已经记下。样本取得后，记得回来交给我。", "end": true},
        {"id": "later", "speaker": "mechanic", "text": "不急，准备好再出发。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.rift.reminder", "entry": "start", "npc_id": "mechanic", "kind": "reminder", "quest_id": "q.c1.rift",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.rift", "value": "active"}],
      "nodes": [{"id": "start", "speaker": "mechanic", "text": "完成裂隙推进会取得样本。调查失败可以重新出击，之前的前哨报告仍然保留。", "end": true}]
    },
    {
      "id": "dlg.c1.rift.turn_in", "entry": "start", "npc_id": "mechanic", "kind": "turn_in", "quest_id": "q.c1.rift",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.rift", "value": "ready_to_turn_in"}],
      "nodes": [
        {"id": "start", "speaker": "mechanic", "text": "这份样本足够做定位。交付后样本会用于分析，完成时就能开放星核任务。", "choices": [
          {"id": "confirm", "text": "交付裂隙样本 ×1", "next": "analysis", "command": {"type": "turn_in_quest", "quest_id": "q.c1.rift"}},
          {"id": "later", "text": "稍后交付", "next": "later"}
        ]},
        {"id": "analysis", "speaker": "mechanic", "text": "位置确认了。干扰集中在星核附近，我把结果留在记录里。", "next": "done"},
        {"id": "done", "speaker": "mage", "text": "观测结果吻合。下一步去找铁匠，确认取回核心后的用途。", "end": true},
        {"id": "later", "speaker": "mechanic", "text": "样本还在你那里。需要分析时再来找我。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.rift.explanation", "entry": "start", "npc_id": "mage", "kind": "optional",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.rift", "value": "completed"}],
      "nodes": [{"id": "start", "speaker": "mage", "text": "样本让我们知道该去哪里。调查记录会一直保留，不必记住每一句话。", "end": true}]
    },
    {
      "id": "dlg.c1.core.accept", "entry": "start", "npc_id": "blacksmith", "kind": "accept", "quest_id": "q.c1.core",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.core", "value": "available"}],
      "nodes": [
        {"id": "start", "speaker": "blacksmith", "text": "通讯装置还缺一个稳定核心。完成星核讨伐后带回1枚，我就能修复它。", "choices": [
          {"id": "accept", "text": "接下任务", "next": "accepted", "command": {"type": "accept_quest", "quest_id": "q.c1.core"}},
          {"id": "later", "text": "稍后再来", "next": "later"}
        ]},
        {"id": "accepted", "speaker": "blacksmith", "text": "星核讨伐已可出击。带回核心后，我们再确认交付。", "end": true},
        {"id": "later", "speaker": "blacksmith", "text": "装置会留在这里，准备好再来。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.core.reminder", "entry": "start", "npc_id": "blacksmith", "kind": "reminder", "quest_id": "q.c1.core",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.core", "value": "active"}],
      "nodes": [{"id": "start", "speaker": "blacksmith", "text": "目标是完成星核讨伐。取得核心后回来交付，这次修复只需1枚。", "end": true}]
    },
    {
      "id": "dlg.c1.core.turn_in", "entry": "start", "npc_id": "blacksmith", "kind": "turn_in", "quest_id": "q.c1.core",
      "conditions": [{"type": "quest_state", "quest_id": "q.c1.core", "value": "ready_to_turn_in"}],
      "nodes": [
        {"id": "start", "speaker": "blacksmith", "text": "交付1枚Boss核心，装置就能恢复工作。核心会被消耗；这是本章的最后一次交付。", "choices": [
          {"id": "confirm", "text": "交付Boss核心 ×1，修复通讯", "next": "repaired", "command": {"type": "turn_in_quest", "quest_id": "q.c1.core"}},
          {"id": "later", "text": "稍后交付", "next": "later"}
        ]},
        {"id": "repaired", "speaker": "blacksmith", "text": "信号接通了，前哨收到回应。修复结果已经记下。", "next": "done"},
        {"id": "done", "speaker": "swordsman", "text": "这一段路走通了。你可以查看本章记录，或重访已经完成的关卡。", "end": true},
        {"id": "later", "speaker": "blacksmith", "text": "核心仍由你保管，回来后再继续修复。", "end": true}
      ]
    },
    {
      "id": "dlg.c1.ruan.advice", "entry": "start", "npc_id": "ruan_dog", "kind": "optional",
      "conditions": [],
      "nodes": [{"id": "start", "speaker": "ruan_dog", "text": "交给营地的记录和样本都放在剧情物品里，不占无尽携带位。忘了用途就打开物品详情，里面写着该找谁。", "end": true}]
    },
    {
      "id": "dlg.c1.afterword", "entry": "start", "npc_id": "swordsman", "kind": "optional",
      "conditions": [{"type": "flag", "flag_id": "chapter1.communications_restored", "value": true}],
      "nodes": [{"id": "start", "speaker": "swordsman", "text": "前哨的回应还在。想试试另一支队伍，就从已通关列表出发；主线记录和已交付结果会保留。", "end": true}]
